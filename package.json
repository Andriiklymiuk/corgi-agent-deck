{
    "name": "corgi-agent-deck",
    "version": "0.4.1",
    "private": true,
    "description": "Stream Deck plugin for corgi's Claude Code session board",
    "scripts": {
        "build": "rollup -c",
        "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.andriiklymiuk.corgi-agent-deck\"",
        "test": "vitest run",
        "typecheck": "tsc --noEmit -p .",
        "validate": "streamdeck validate com.andriiklymiuk.corgi-agent-deck.sdPlugin",
        "pack": "streamdeck pack com.andriiklymiuk.corgi-agent-deck.sdPlugin",
        "showcase": "tsx scripts/showcase.ts && scripts/capture.sh"
    },
    "type": "module",
    "devDependencies": {
        "@elgato/cli": "^1.9.0",
        "@rollup/plugin-commonjs": "^29.0.2",
        "@rollup/plugin-node-resolve": "^15.2.2",
        "@rollup/plugin-terser": "^1.0.0",
        "@rollup/plugin-typescript": "^12.1.0",
        "@tsconfig/node20": "^20.1.2",
        "@types/node": "~24.1.0",
        "rollup": "^4.0.2",
        "tslib": "^2.6.2",
        "tsx": "4.23.13",
        "typescript": "^5.2.2",
        "vitest": "^3.2.4"
    },
    "dependencies": {
        "@elgato/streamdeck": "^2.1.2"
    }
}
